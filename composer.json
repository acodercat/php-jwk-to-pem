{
    "name": "codercat/jwk-to-pem",
    "description": "Convert JWK to PEM format.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "codercat",
            "email": "1067302838@qq.com"
        }
    ],
    "require": {
        "php": ">=7.1",
        "phpseclib/phpseclib": "^3.0.59"
    },
    "require-dev": {
